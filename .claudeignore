# ==============================================================================
# .claudeignore - Multi-language & Multi-framework Template
# Ignores dependencies, build outputs, environment variables, logs, and metadata.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERSION CONTROL & CLOUD METADATA
# ------------------------------------------------------------------------------
.git/
.svn/
.hg/
.bzr/
.terraform/
.aws/
.azure/

# ------------------------------------------------------------------------------
# 2. SENSITIVE DATA & ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
*.env
*.env.*
!*.env.example
!*.env.template
*.pem
*.crt
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
*.id_rsa
secrets.*
*.secret

# ------------------------------------------------------------------------------
# 3. JAVASCRIPT / TYPESCRIPT / NODE.JS / NESTJS / FRONTEND
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
jspm_packages/
.pnpm-store/

# Build and Output directories
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.vuepress/dist/
.angular/
.turbo/

# Logs and Caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
.prettiercache
.tsbuildinfo
*.tsbuildinfo

# Package Manager Lockfiles (Optional: uncomment if you want to reduce prompt token usage)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ------------------------------------------------------------------------------
# 4. PYTHON
# ------------------------------------------------------------------------------
# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
*.egg-info/
.eggs/

# ------------------------------------------------------------------------------
# 5. JAVA / KOTLIN (Maven / Gradle)
# ------------------------------------------------------------------------------
# Maven
target/
*.class

# Gradle
.gradle/
build/

# Package Files
*.jar
*.war
*.ear
*.nar

# ------------------------------------------------------------------------------
# 6. C# / .NET
# ------------------------------------------------------------------------------
# Build outputs
bin/
obj/
out/

# NuGet Packages & Cache
*.nupkg
packages/
.nuget/

# Rider / Visual Studio specific files
*.user
*.userosv
*.sln.docstates

# ------------------------------------------------------------------------------
# 7. OTHER LANGUAGES (Go, Rust, C/C++, PHP)
# ------------------------------------------------------------------------------
# Go
vendor/

# Rust
target/

# C / C++
*.o
*.obj
*.so
*.dylib
*.dll
*.exe

# PHP
vendor/

# ------------------------------------------------------------------------------
# 8. IDEs, EDITORS & SYSTEM FILES
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.suo
*.user
*.workspace

# ------------------------------------------------------------------------------
# 9. MEDIA, DOCUMENTS & HEAVY ASSETS
# ------------------------------------------------------------------------------
# Media
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.webp
*.mp4
*.mp3
*.mov
*.pdf

# Archives
*.zip
*.tar
*.tar.gz
*.gz
*.7z
*.rar

# Databases & Dump Files
*.sqlite
*.sqlite3
*.db
*.sql
*.dump

# Logs
*.log
logs/